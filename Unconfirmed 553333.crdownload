import { ai, db } from 'hatchable';
export const access='user'; export const methods=['POST'];
export default async function(req,res){const b=req.body||{};if(!b.patient_id||!b.request)return res.status(400).json({error:'patient_id and request are required'});if(String(b.request).length>4000)return res.status(400).json({error:'Request too long'});const p=await db.query('SELECT full_name,date_of_birth,gender,blood_group,allergies,conditions,notes FROM patients WHERE id=$1 AND user_id=$2',[b.patient_id,req.user.id]);if(!p.rows[0])return res.status(404).json({error:'Patient not found'});const patient=p.rows[0];const result=await ai.generateText({model:'sonnet',purpose:'medication-assistant',userId:req.user.id,maxTokens:900,system:'You are a medication-management assistant inside a college SaaS demo. Never diagnose, prescribe, change doses, or claim medical certainty. Help organize information, flag potential questions for a qualified clinician, and draft reminder schedules. Clearly state that a licensed clinician/pharmacist must make treatment decisions. Do not infer missing clinical facts.',prompt:`Patient profile: ${JSON.stringify(patient)}\nUser request: ${b.request}`});res.json({answer:result.text,usage:result.usage});}