const API=window.__HATCHABLE__.api;let clockTimer;function updateClock(){const now=new Date();const time=now.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',second:'2-digit'});const el=document.getElementById('liveClock');if(el)el.textContent=time;const cd=document.getElementById('nextDose');if(cd){const upcoming=state.reminders.filter(r=>!r.taken).map(r=>{const [h,m]=String(r.reminder_time).split(':').map(Number);const d=new Date(now);d.setHours(h,m,0,0);if(d<=now)d.setDate(d.getDate()+1);return {r,d};}).sort((a,b)=>a.d-b.d)[0];if(upcoming){let s=Math.max(0,Math.floor((upcoming.d-now)/1000)),h=Math.floor(s/3600),mm=Math.floor((s%3600)/60),ss=s%60;cd.textContent=`Next dose: ${String(h).padStart(2,'0')}:${String(mm).padStart(2,'0')}:${String(ss).padStart(2,'0')}`; }else cd.textContent='No pending doses';}}function startClock(){clearInterval(clockTimer);updateClock();clockTimer=setInterval(updateClock,1000);}let state={page:'dashboard',patients:[],prescriptions:[],reminders:[],user:null};const app=document.getElementById('app');const esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#039;'}[c]));async function api(path,opt={}){const r=await fetch(API+path,{headers:{'Content-Type':'application/json'},...opt});if(r.status===401){location.href='/login?next=/';throw Error('Sign in required')}const d=await r.json();if(!r.ok)throw Error(d.error||'Request failed');return d}function toast(t){const x=document.getElementById('toast');x.textContent=t;x.style.display='block';setTimeout(()=>x.style.display='none',2200)}async function load(){const s=await window.hatchable.auth.getSession();if(!s||!s.user){location.href='/login?next=/';return}state.user=s.user;document.getElementById('userbox').textContent=s.user.email;state.patients=await api('/patients');state.prescriptions=await api('/prescriptions');state.reminders=await api('/reminders');render()}function render(){document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.page===state.page));document.getElementById('title').textContent=({dashboard:'Good day 👋',patients:'Patients',prescriptions:'Prescriptions',reminders:'Medicine reminders',ai:'AI medication assistant'})[state.page];({dashboard:dashboard,patients:patients,prescriptions:prescriptions,reminders:reminders,ai:ai})[state.page]()}function dashboard(){const pending=state.reminders.filter(r=>!r.taken).length;app.innerHTML=`<div class='grid'><div class='stat'><span class='icon'>♙</span><div class='label'>Total patients</div><div class='num'>${state.patients.length}</div></div><div class='stat'><span class='icon'>▤</span><div class='label'>Active prescriptions</div><div class='num'>${state.prescriptions.length}</div></div><div class='stat'><span class='icon'>◷</span><div class='label'>Pending reminders</div><div class='num'>${pending}</div></div></div><div class='panel'><div class='toolbar'><div><h2>Medication schedule</h2><div class='countdown' id='nextDose'>Checking next dose…</div></div><button class='btn' onclick="state.page='reminders';render()">View reminders</button></div>${state.reminders.slice(0,6).map(r=>`<div class='reminder'><div class='time'>${esc(r.reminder_time)}</div><div style='flex:1'><b>${esc(r.medicine_name||r.label)}</b><div class='muted'>${esc(r.full_name)} · ${esc(r.label)}</div></div><span class='badge'>${r.taken?'Taken':'Upcoming'}</span></div>`).join('')||'<p class=muted>No reminders yet. Add one from the Reminders section.</p>'}</div>`}function patients(){app.innerHTML=`<div class='panel'><div class='toolbar'><h2>Patient profiles</h2><button class='btn' onclick="patientForm()">+ Add patient</button></div><table class='table'><tr><th>Name</th><th>DOB</th><th>Blood group</th><th>Allergies</th><th>Conditions</th><th>Action</th></tr>${state.patients.map(p=>`<tr><td><b>${esc(p.full_name)}</b><br><span class=muted>${esc(p.gender)}</span></td><td>${esc(p.date_of_birth)||'—'}</td><td>${esc(p.blood_group)||'—'}</td><td>${esc(p.allergies)||'None recorded'}</td><td>${esc(p.conditions)||'None recorded'}</td><td><button class='btn secondary' onclick="patientForm('${p.id}')">Edit</button> <button class='btn secondary' onclick="sendTestSms('${p.id}')">Send SMS</button> <button class='delete-btn' onclick="deleteRecord('patient','${p.id}')">Delete</button></td></tr>`).join('')||'<tr><td colspan=6>No patients yet.</td></tr>'}</table></div>`}function patientForm(id){const p=id?state.patients.find(x=>x.id===id):null;app.innerHTML=`<div class='panel'><div class='toolbar'><h2>${p?'Edit patient':'New patient'}</h2><button class='btn secondary' onclick="state.page='patients';render()">Cancel</button></div><form id='pf' class='formgrid'><input name='full_name' placeholder='Full name *' value='${esc(p?.full_name)}' required><input name='date_of_birth' type='date' value='${esc(p?.date_of_birth)}'><select name='gender'><option value=''>Gender</option><option>Female</option><option>Male</option><option>Other</option></select><input name='blood_group' placeholder='Blood group (e.g. O+)' value='${esc(p?.blood_group)}'><input name='phone' placeholder='Phone in E.164 format, e.g. +919876543210' value='${esc(p?.phone)}'><input name='email' type='email' placeholder='Email' value='${esc(p?.email)}'><label class='full'><input name='sms_opt_in' type='checkbox' value='true' ${p?.sms_opt_in?'checked':''}> Allow medicine reminder SMS to this patient</label><input name='allergies' class='full' placeholder='Known allergies' value='${esc(p?.allergies)}'><input name='conditions' class='full' placeholder='Medical conditions' value='${esc(p?.conditions)}'><input name='emergency_contact' class='full' placeholder='Emergency contact' value='${esc(p?.emergency_contact)}'><textarea name='notes' class='full' placeholder='Additional notes'>${esc(p?.notes)}</textarea><div class='full form-actions'><button class='btn'>Save patient</button></div></form></div>`;document.getElementById('pf').onsubmit=async e=>{e.preventDefault();await api('/patients',{method:p?'PUT':'POST',body:JSON.stringify({...Object.fromEntries(new FormData(e.target)),sms_opt_in:e.target.sms_opt_in?.checked===true,...(p?{id:p.id}:{})})});toast(p?'Patient updated':'Patient added');state.patients=await api('/patients');state.page='patients';render()}}function prescriptions(){app.innerHTML=`<div class='panel'><div class='toolbar'><h2>Prescription records</h2><button class='btn' onclick="prescriptionForm()">+ Add prescription</button></div><table class='table'><tr><th>Patient</th><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Route</th><th>Instructions</th><th>Action</th></tr>${state.prescriptions.map(p=>`<tr><td>${esc(p.full_name)}</td><td><b>${esc(p.medicine_name)}</b></td><td>${esc(p.dosage)}</td><td>${esc(p.frequency)}</td><td>${esc(p.route)}</td><td>${esc(p.instructions)||'—'}</td><td><button class='btn secondary' onclick="prescriptionForm('${p.id}')">Edit</button> <button class='delete-btn' onclick="deleteRecord('prescription','${p.id}')">Delete</button></td></tr>`).join('')||'<tr><td colspan=7>No prescriptions yet.</td></tr>'}</table></div>`}function prescriptionForm(id){const p=id?state.prescriptions.find(x=>x.id===id):null;app.innerHTML=`<div class='panel'><h2>${p?'Edit prescription':'Create prescription record'}</h2><p class='muted'>For demo use only. Medication decisions must be made by a qualified clinician.</p><form id='rx' class='formgrid'><select name='patient_id' required><option value=''>Select patient *</option>${state.patients.map(x=>`<option value='${x.id}' ${p?.patient_id===x.id?'selected':''}>${esc(x.full_name)}</option>`).join('')}</select><input name='medicine_name' placeholder='Medicine name *' value='${esc(p?.medicine_name)}' required><input name='dosage' placeholder='Dosage e.g. 500 mg *' value='${esc(p?.dosage)}' required><input name='frequency' placeholder='Frequency e.g. twice daily *' value='${esc(p?.frequency)}' required><select name='route'><option>Oral</option><option>Topical</option><option>Inhaled</option><option>Injection</option></select><input name='prescribed_by' placeholder='Prescribed by' value='${esc(p?.prescribed_by)}'><input name='start_date' type='date' value='${esc(p?.start_date)}'><input name='end_date' type='date' value='${esc(p?.end_date)}'><textarea name='instructions' class='full' placeholder='Instructions'>${esc(p?.instructions)}</textarea><div class='full form-actions'><button class='btn'>Save prescription</button><button type='button' class='btn secondary' onclick="state.page='prescriptions';render()">Cancel</button></div></form></div>`;document.getElementById('rx').onsubmit=async e=>{e.preventDefault();await api('/prescriptions',{method:p?'PUT':'POST',body:JSON.stringify({...Object.fromEntries(new FormData(e.target)),...(p?{id:p.id}:{})})});state.prescriptions=await api('/prescriptions');toast('Prescription saved');state.page='prescriptions';render()}}function reminders(){app.innerHTML=`<div class='panel'><div class='toolbar'><h2>Reminder schedule</h2><button class='btn' onclick="reminderForm()">+ Add reminder</button></div>${state.reminders.map(r=>`<div class='reminder'><div class='time'>${esc(r.reminder_time)}</div><div style='flex:1'><b>${esc(r.medicine_name||r.label)}</b><div class='muted'>${esc(r.full_name)} · ${esc(r.label)} · SMS: ${esc(r.delivery_status||'pending')}${r.delivery_error?' — '+esc(r.delivery_error):''}</div></div><button class='btn ${r.taken?'secondary':''}' onclick="toggleReminder('${r.id}',${!r.taken})">${r.taken?'Mark pending':'Mark taken'}</button><button class='btn secondary' onclick="reminderForm('${r.id}')">Edit</button><button class='delete-btn' onclick="deleteRecord('reminder','${r.id}')">Delete</button></div>`).join('')||'<p class=muted>No reminders yet.</p>'}</div>`}function reminderForm(id){const r=id?state.reminders.find(x=>x.id===id):null;app.innerHTML=`<div class='panel'><h2>${r?'Edit medicine reminder':'Add medicine reminder'}</h2><p class='muted'>If the patient has SMS consent and a phone number, the reminder will be sent automatically at this time every day.</p><form id='rf' class='formgrid'><select name='patient_id' required onchange='filterRx(this.value)'><option value=''>Select patient *</option>${state.patients.map(p=>`<option value='${p.id}' ${r?.patient_id===p.id?'selected':''}>${esc(p.full_name)}</option>`).join('')}</select><select name='prescription_id' id='rxsel'><option value=''>Optional prescription</option>${state.prescriptions.filter(p=>!r||p.patient_id===r.patient_id).map(p=>`<option value='${p.id}' ${r?.prescription_id===p.id?'selected':''}>${esc(p.medicine_name)} — ${esc(p.dosage)}</option>`).join('')}</select><input name='scheduled_at' type='datetime-local' value='${esc(r?.scheduled_at?(()=>{const d=new Date(r.scheduled_at);return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,16)})():'')}' required><input type='hidden' name='timezone' id='rxtz'><input name='label' placeholder='Label e.g. After breakfast' value='${esc(r?.label)}' required><textarea name='message' class='full' placeholder='SMS message (optional)'>${esc(r?.message)}</textarea><div class='full form-actions'><button class='btn'>${r?'Save reminder':'Create reminder'}</button><button type='button' class='btn secondary' onclick="state.page='reminders';render()">Cancel</button></div></form></div>`;document.getElementById('rxtz').value=r?.timezone||Intl.DateTimeFormat().resolvedOptions().timeZone||'Asia/Kolkata';document.getElementById('rf').onsubmit=async e=>{e.preventDefault();const f=e.target;const submit=f.querySelector('button.btn');submit.disabled=true;const old=submit.textContent;submit.textContent='Saving…';try{const data=Object.fromEntries(new FormData(f));if(!data.scheduled_at||!data.patient_id||!data.label?.trim())throw Error('Please select a patient, scheduled date/time, and enter a reminder label.');data.reminder_time=data.scheduled_at.slice(11,16);data.scheduled_at=new Date(data.scheduled_at).toISOString();await api('/reminders',{method:r?'PUT':'POST',body:JSON.stringify({...data,...(r?{id:r.id,edit:true}:{})})});state.reminders=await api('/reminders');toast(r?'Reminder updated':'Reminder created');state.page='reminders';render()}catch(err){toast(err.message||'Could not save reminder');submit.disabled=false;submit.textContent=old}}}function filterRx(pid){document.getElementById('rxsel').innerHTML='<option value="">Optional prescription</option>'+state.prescriptions.filter(p=>p.patient_id===pid).map(p=>`<option value='${p.id}'>${esc(p.medicine_name)} — ${esc(p.dosage)}</option>`).join('');}async function sendTestSms(id){const p=state.patients.find(x=>x.id===id);if(!p)return;if(!p.phone)return toast('Add a phone number first');if(!p.sms_opt_in)return toast('Enable SMS consent for this patient');if(!confirm('Send a test SMS to '+p.full_name+' at '+p.phone+'?'))return;try{toast('Sending test SMS…');const r=await api('/send-test-sms',{method:'POST',body:JSON.stringify({patientId:id})});toast(r.message||'Test SMS sent');}catch(e){toast(e.message)}}async function toggleReminder(id,taken){await api('/reminders',{method:'PUT',body:JSON.stringify({id,taken})});state.reminders=await api('/reminders');render()}async function deleteRecord(type,id){const label=type==='patient'?'patient':type==='prescription'?'prescription':'reminder';if(!confirm(`Delete this ${label}? This cannot be undone.`))return;const path=type==='patient'?'/patients':type==='prescription'?'/prescriptions':'/reminders';await api(path,{method:'DELETE',body:JSON.stringify({id})});state.patients=await api('/patients');state.prescriptions=await api('/prescriptions');state.reminders=await api('/reminders');toast(`${label[0].toUpperCase()+label.slice(1)} deleted`);render()}function ai(){app.innerHTML=`<div class='ai-box'><h2>✦ Patient-aware AI assistant</h2><p class='muted'>Ask the assistant to organize a medication schedule, summarize a patient profile, or prepare questions for a clinician. It does not diagnose or prescribe.</p><select id='aipat'><option value=''>Choose a patient</option>${state.patients.map(p=>`<option value='${p.id}'>${esc(p.full_name)}</option>`).join('')}</select><textarea id='aireq' style='margin-top:12px' placeholder='Example: Help me turn this prescription list into a simple morning / afternoon / evening reminder plan. Flag anything I should confirm with a pharmacist.'></textarea><div class='form-actions'><button class='btn' onclick='askAI()'>Ask AI</button></div><div id='aiout' class='ai-answer'></div></div>`}async function askAI(){const patient_id=document.getElementById('aipat').value,request=document.getElementById('aireq').value;if(!patient_id||!request)return toast('Choose a patient and enter a request');document.getElementById('aiout').textContent='Thinking…';try{const r=await api('/ai-assist',{method:'POST',body:JSON.stringify({patient_id,request})});document.getElementById('aiout').textContent=r.answer}catch(e){document.getElementById('aiout').textContent=e.message}}document.querySelectorAll('.nav').forEach(n=>n.onclick=()=>{state.page=n.dataset.page;render()});document.getElementById('logout').onclick=async()=>{await window.hatchable.auth.signOut();location.href='/login'};load();startClock();